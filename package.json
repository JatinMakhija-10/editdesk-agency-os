{
  "name": "editdesk",
  "version": "1.0.0",
  "description": "EditDesk — SYN Studio Agency Order, Payout & AI Finance Manager (Desktop + iPhone)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:server": "node server/index.mjs",
    "dev:ui": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && node launch-desktop.mjs",
    "desktop": "electron .",
    "test": "node --test tests/ledger.test.mjs tests/api.test.mjs"
  },
  "keywords": [],
  "author": "SYN Studio",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.33",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^45.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.4.0"
  }
}
